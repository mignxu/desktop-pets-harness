{
  "name": "desktop-pets-harness",
  "version": "0.0.1",
  "private": true,
  "description": "Desktop-pet shell for multiple agent harnesses - v0 technical spikes",
  "main": "src/main/main.js",
  "scripts": {
    "gen:frames": "node tools/gen-frames.mjs",
    "start": "electron .",
    "start:mock": "electron . --mock",
    "spikes": "electron . --self-test",
    "smoke": "electron . --smoke",
    "panel:build": "vite build --config panel.vite.config.js",
    "icon": "node scripts/gen-icon.js",
    "dist": "npm run panel:build && npm run icon && electron-builder --win",
    "dist:dir": "npm run panel:build && npm run icon && electron-builder --win --dir",
    "test:approval": "node scripts/test-approval-loop.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@arco-design/web-react": "^2.66.16",
    "marked": "^18.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "author": "desktop-pets-harness"
}
